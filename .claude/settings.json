{
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./init.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start_recap.sh"
          }
        ]
      }
    ]
  }
}
